{
  "name": "environmental-simulation",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based environmental simulation for architecture and interior studies (sun path, sun hours, radiation, sky view, daylight, climate & comfort) inspired by Ladybug Tools.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
